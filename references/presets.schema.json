{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adri-style.local/schemas/presets.schema.json",
  "title": "Contrato de presets adri-style v5.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema_version",
    "adri_style_version",
    "generated_at",
    "source_canonical",
    "warning_for_humans",
    "presets"
  ],
  "properties": {
    "$schema_version": { "const": "1.0" },
    "adri_style_version": { "const": "5.8" },
    "generated_at": { "type": "string", "format": "date" },
    "source_canonical": { "type": "string", "minLength": 1 },
    "warning_for_humans": { "type": "string", "minLength": 1 },
    "presets": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "n",
        "name",
        "fonts",
        "color",
        "mode_default",
        "estado",
        "uso_real"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-9]|2[0-7])-[a-z0-9-]+$"
        },
        "n": { "type": "integer", "minimum": 1, "maximum": 27 },
        "name": { "type": "string", "minLength": 1 },
        "default": { "type": "boolean" },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "body",
            "single_font",
            "single_font_justified",
            "weights_display",
            "weights_body",
            "body_default_over_500"
          ],
          "properties": {
            "display": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "single_font": { "type": "boolean" },
            "single_font_justified": {
              "type": ["string", "null"]
            },
            "weights_display": { "type": "string", "minLength": 1 },
            "weights_body": { "type": "string", "minLength": 1 },
            "body_default_over_500": { "type": "boolean" }
          }
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bg", "accent"],
          "properties": {
            "bg": { "type": "string", "minLength": 1 },
            "accent": { "type": "string", "minLength": 1 }
          }
        },
        "mode_default": { "enum": ["light", "dark"] },
        "estado": {
          "enum": ["activo", "activo-frágil", "revisión-30d"]
        },
        "uso_real": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
